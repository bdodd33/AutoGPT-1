<div class="reveal is-visible">
  <div class="site-header__logo" style="font-size:2.4rem;margin-bottom:1rem;">MW<span>Faith</span></div>
  <span class="eyebrow">Luxury Christian Apparel — Launching Soon</span>
  <h1 style="font-size:clamp(2rem,5vw,3.5rem);">Wear Your Faith. Walk in Purpose.</h1>
  <p class="text-muted">Be the first to know when we drop. Join the community and get an exclusive launch reward.</p>

  {%- form 'customer', class: 'newsletter__form' -%}
    {%- if form.posted_successfully? -%}
      <p style="color:var(--color-gold);flex-basis:100%;">You're on the list. Watch your inbox.</p>
    {%- else -%}
      <input class="field" type="email" name="contact[email]" placeholder="Enter your email" required>
      <button type="submit" class="btn">Notify Me</button>
    {%- endif -%}
  {%- endform -%}

  <p class="mt-2">
    {{ 'general.password_page.login_form_heading' | t | default: 'Enter store using password:' }}
  </p>
  {%- form 'storefront_password', class: 'newsletter__form' -%}
    {{ form.errors | default_errors }}
    <input class="field" type="password" name="password" placeholder="Password" required>
    <button type="submit" class="btn btn--ghost">Enter</button>
  {%- endform -%}
</div>
