<section class="section">
  <div class="page-width" style="max-width:440px;">
    <div class="section-heading center reveal"><h1>Reset Password</h1></div>
    {%- form 'reset_customer_password', class: 'product__options' -%}
      {{ form.errors | default_errors }}
      <div><label for="rp1">New password</label><input class="field" id="rp1" type="password" name="customer[password]" required></div>
      <div><label for="rp2">Confirm password</label><input class="field" id="rp2" type="password" name="customer[password_confirmation]" required></div>
      <button type="submit" class="btn btn--block">Reset Password</button>
    {%- endform -%}
  </div>
</section>
