<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="theme-color" content="{{ settings.color_background | default: '#0d0d0f' }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">
    {%- endif -%}

    {%- comment -%} ---------- SEO: title & meta ---------- {%- endcomment -%}
    <title>{{ page_title }}{% unless page_title contains shop.name %} &middot; {{ shop.name }}{% endunless %}</title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}
    <meta name="robots" content="index, follow, max-image-preview:large">

    {%- comment -%} ---------- Open Graph + Twitter + JSON-LD ---------- {%- endcomment -%}
    {% render 'meta-tags' %}

    {%- comment -%} ---------- Fonts ---------- {%- endcomment -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    {{ 'base.css' | asset_url | stylesheet_tag }}

    {%- comment -%} Money format for JS, plus Shopify required objects {%- endcomment -%}
    <script>window.MWFAITH_MONEY_FORMAT = {{ shop.money_format | json }};</script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ request.page_type | handle }}">
    <a class="visually-hidden" href="#MainContent">{{ 'general.skip_to_content' | t | default: 'Skip to content' }}</a>

    {% section 'announcement-bar' %}
    {% section 'header' %}

    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    {%- comment -%} ---------- Cart drawer ---------- {%- endcomment -%}
    <aside class="cart-drawer" data-cart-drawer aria-hidden="true">
      <div class="cart-drawer__overlay" data-cart-close></div>
      <div class="cart-drawer__panel" role="dialog" aria-label="Cart">
        <div class="cart-drawer__head">
          <h3>Your Cart</h3>
          <button class="icon-btn" data-cart-close aria-label="Close cart">&times;</button>
        </div>
        <div class="cart-drawer__body" data-cart-body></div>
        <div class="cart-drawer__footer" data-cart-footer hidden>
          <div class="cart-drawer__subtotal"><span>Subtotal</span><span data-cart-subtotal></span></div>
          <p class="text-muted" style="font-size:.78rem;">Shipping & rewards points calculated at checkout.</p>
          <a href="{{ routes.cart_url }}" class="btn btn--block">Checkout</a>
        </div>
      </div>
    </aside>

    <style>
      .cart-drawer { position: fixed; inset: 0; z-index: 100; visibility: hidden; }
      .cart-drawer.is-open { visibility: visible; }
      .cart-drawer__overlay { position: absolute; inset: 0; background: rgba(0,0,0,.6); opacity: 0; transition: opacity .4s; }
      .cart-drawer.is-open .cart-drawer__overlay { opacity: 1; }
      .cart-drawer__panel { position: absolute; top: 0; right: 0; height: 100%; width: min(420px, 92vw); background: var(--color-bg); border-left: 1px solid var(--color-line); transform: translateX(100%); transition: transform .45s cubic-bezier(.16,1,.3,1); display: flex; flex-direction: column; padding: 1.5rem; }
      .cart-drawer.is-open .cart-drawer__panel { transform: none; }
      .cart-drawer__head { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--color-line); padding-bottom: 1rem; }
      .cart-drawer__head .icon-btn { font-size: 1.6rem; }
      .cart-drawer__body { flex: 1; overflow-y: auto; padding-block: 1rem; display: grid; gap: 1rem; align-content: start; }
      .drawer-item { display: grid; grid-template-columns: 64px 1fr; gap: 1rem; align-items: start; }
      .drawer-item__title { font-weight: 600; margin: 0 0 .2rem; }
      .cart-drawer__subtotal { display: flex; justify-content: space-between; font-family: var(--font-heading); font-size: 1.2rem; margin-bottom: .5rem; }
      .cart-drawer__footer { border-top: 1px solid var(--color-line); padding-top: 1rem; }
    </style>

    {{ 'theme.js' | asset_url | script_tag }}
  </body>
</html>
