<section class="section">
  <div class="page-width" style="max-width:560px;">
    <div class="section-heading center reveal">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h1>{{ section.settings.heading }}</h1>
      <p class="text-muted">{{ section.settings.subheading }}</p>
    </div>

    {%- form 'contact', class: 'product__options' -%}
      {{ form.errors | default_errors }}
      {%- if form.posted_successfully? -%}
        <p style="color:var(--color-gold);">Thanks for reaching out — we'll reply within 1–2 business days.</p>
      {%- endif -%}
      <input class="field" type="text" name="contact[name]" placeholder="Name" required>
      <input class="field" type="email" name="contact[email]" placeholder="Email" required>
      <textarea class="field" name="contact[body]" rows="5" placeholder="How can we help?" required></textarea>
      <button type="submit" class="btn btn--block">Send Message</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Get in Touch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact Us" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Questions about an order, sizing, or a wholesale inquiry? We'd love to hear from you." }
  ],
  "presets": [ { "name": "Contact form" } ]
}
{% endschema %}
