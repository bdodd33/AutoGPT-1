<section class="section">
  <div class="page-width">
    <div class="section-heading center reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>

    {%- assign blog = blogs[section.settings.blog] -%}
    <div class="grid article-grid">
      {%- if blog != blank and blog.articles_count > 0 -%}
        {%- for article in blog.articles limit: section.settings.posts_to_show -%}
          {% render 'article-card', article: article %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <div class="article-card reveal">
            <div class="article-card__media">{{ 'lifestyle-1' | placeholder_svg_tag: '' }}</div>
            <p class="article-card__meta">Faith &amp; Style</p>
            <h3 class="article-card__title">Sample blog post {{ i }}</h3>
            <p class="article-card__excerpt">Connect your blog in the theme editor to display real posts here.</p>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if blog != blank -%}
      <div class="center mt-2"><a href="{{ blog.url }}" class="btn btn--ghost">Read the Journal</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog posts",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Faith, Style & Purpose" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "posts_to_show", "min": 2, "max": 6, "step": 1, "label": "Posts to show", "default": 3 }
  ],
  "presets": [ { "name": "Blog posts" } ]
}
{% endschema %}
