<section class="section">
  <div class="page-width">
    <div class="section-heading center reveal">
      <span class="eyebrow">Collection</span>
      <h1>{{ collection.title }}</h1>
      {%- if collection.description != blank -%}<div class="text-muted rte">{{ collection.description }}</div>{%- endif -%}
    </div>

    {%- if collection.products.size > 0 -%}
      {%- paginate collection.products by 24 -%}
        <div class="grid product-grid">
          {%- for product in collection.products -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <nav class="center mt-2" aria-label="Pagination">{{ paginate | default_pagination }}</nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      <p class="center text-muted">No products yet — check back soon for new drops.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Collection", "settings": [ { "type": "paragraph", "content": "Displays products in the current collection." } ] }
{% endschema %}
