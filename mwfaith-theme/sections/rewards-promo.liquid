<section class="section" style="background: var(--color-surface);">
  <div class="page-width center reveal">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }}</h2>
    <p class="text-muted" style="max-width:54ch;margin-inline:auto;">{{ section.settings.subheading }}</p>

    <div class="grid rewards-steps mt-2" style="margin-top:3rem;text-align:left;">
      {%- for block in section.blocks -%}
        <div class="rewards-step" {{ block.shopify_attributes }}>
          <h3 style="font-size:1.15rem;">{{ block.settings.title }}</h3>
          <p class="text-muted" style="font-size:.92rem;">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="btn mt-2" style="margin-top:2.5rem;">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Rewards promo",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Faith Rewards" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get Rewarded for Wearing Your Faith" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Join free and start earning points on every purchase, review, and referral. Redeem for discounts, early access to drops, and members-only designs." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Join Faith Rewards" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Create your account" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Sign up free and instantly receive 200 welcome points." }
    ] }
  ],
  "presets": [ {
    "name": "Rewards promo",
    "blocks": [
      { "type": "step", "settings": { "title": "Create your account", "text": "Sign up free and instantly receive 200 welcome points." } },
      { "type": "step", "settings": { "title": "Earn on everything", "text": "1 point per $1 spent, plus points for reviews, referrals & birthdays." } },
      { "type": "step", "settings": { "title": "Redeem & ascend", "text": "Cash points in for discounts and climb tiers for bigger perks." } }
    ]
  } ]
}
{% endschema %}
