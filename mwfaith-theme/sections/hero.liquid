<section class="hero">
  <div class="hero__media">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 2400 }}"
           srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1600 }} 1600w, {{ section.settings.image | image_url: width: 2400 }} 2400w"
           sizes="100vw" alt="{{ section.settings.image.alt | escape }}" width="2400" height="1400" fetchpriority="high">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
    {%- endif -%}
  </div>
  <div class="page-width hero__content reveal">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h1>{{ section.settings.heading }}</h1>
    <p class="lead">{{ section.settings.subheading }}</p>
    <div class="hero__cta">
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="btn">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.button_label_2 != blank -%}
        <a href="{{ section.settings.button_link_2 }}" class="btn btn--ghost">{{ section.settings.button_label_2 }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Luxury Christian Apparel" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wear Your Faith. Walk in Purpose." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Premium, made-to-order garments designed for the modern believer. Every piece is a quiet testimony — crafted to be worn, lived in, and noticed." },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "Shop the Collection" },
    { "type": "url", "id": "button_link", "label": "Primary link" },
    { "type": "text", "id": "button_label_2", "label": "Secondary button", "default": "Our Story" },
    { "type": "url", "id": "button_link_2", "label": "Secondary link" }
  ],
  "presets": [ { "name": "Hero" } ]
}
{% endschema %}
