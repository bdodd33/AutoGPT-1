<section class="section" data-product-root>
  <div class="page-width product">
    {%- comment -%} ---------- Gallery ---------- {%- endcomment -%}
    <div class="product__gallery">
      {%- if product.featured_media -%}
        <img data-main-image src="{{ product.featured_media | image_url: width: 1200 }}" alt="{{ product.featured_media.alt | default: product.title | escape }}" width="1200" height="1500" fetchpriority="high">
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: '' }}
      {%- endif -%}
      {%- if product.media.size > 1 -%}
        <div class="product__thumbs">
          {%- for media in product.media -%}
            <img data-thumb data-full="{{ media | image_url: width: 1200 }}" src="{{ media | image_url: width: 160 }}" alt="{{ media.alt | escape }}" width="76" height="92" loading="lazy">
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ---------- Details ---------- {%- endcomment -%}
    <div class="product__details">
      {%- if product.tags contains 'new' -%}<span class="eyebrow">New Arrival</span>{%- endif -%}
      <h1>{{ product.title }}</h1>
      <div class="product__price" data-product-price>{{ product.selected_or_first_available_variant.price | money }}</div>

      <div class="rte text-muted">{{ product.description }}</div>

      <script type="application/json" data-variants>
        [{%- for v in product.variants -%}
          {"id": {{ v.id }}, "available": {{ v.available }}, "price": {{ v.price }}, "options": {{ v.options | json }}}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}]
      </script>

      <form data-product-form method="post" action="{{ routes.cart_add_url }}" enctype="multipart/form-data">
        <div class="product__options">
          {%- for option in product.options_with_values -%}
            <div class="option-group">
              <label>{{ option.name }}</label>
              {%- assign opt_key = 'option' | append: option.position -%}
              {%- if option.name == 'Color' or option.name == 'Colour' -%}
                <div class="swatch-row">
                  {%- for value in option.values -%}
                    <button type="button" class="swatch {% if value == option.selected_value %}swatch--active{% endif %}"
                            title="{{ value }}" data-option="{{ value | escape }}" data-option-key="{{ opt_key }}"
                            style="background:{{ value | downcase | replace: ' ', '' }};"></button>
                  {%- endfor -%}
                </div>
              {%- else -%}
                <div class="size-row">
                  {%- for value in option.values -%}
                    <button type="button" class="size-pill {% if value == option.selected_value %}size-pill--active{% endif %}"
                            data-option="{{ value | escape }}" data-option-key="{{ opt_key }}">{{ value }}</button>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button type="submit" class="btn btn--block" {% unless product.available %}disabled{% endunless %}>
          {% if product.available %}Add to Cart{% else %}Sold Out{% endif %}
        </button>
        <p class="text-muted center" style="font-size:.8rem;margin-top:1rem;">
          {% render 'icon', name: 'gift' %} Earn {{ product.price | divided_by: 100 }} Faith Rewards points with this order
        </p>
      </form>

      <div class="product__accordion">
        {%- for block in section.blocks -%}
          {%- if block.type == 'accordion' -%}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.heading }}</summary>
              <div class="content rte">{{ block.settings.content }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product",
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Details & Fabric" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Premium heavyweight cotton, garment-dyed for a vintage soft-washed feel. Printed on demand using eco-friendly DTG inks. Unisex relaxed fit.</p>" }
      ]
    }
  ],
  "presets": [ {
    "name": "Product",
    "blocks": [
      { "type": "accordion", "settings": { "heading": "Details & Fabric", "content": "<p>Premium heavyweight cotton, garment-dyed for a soft-washed feel. Printed on demand with eco-friendly inks. Unisex relaxed fit.</p>" } },
      { "type": "accordion", "settings": { "heading": "Shipping & Returns", "content": "<p>Made to order and shipped within 3–5 business days. 30-day satisfaction guarantee.</p>" } },
      { "type": "accordion", "settings": { "heading": "Care", "content": "<p>Machine wash cold, inside out. Tumble dry low. Do not iron directly on print.</p>" } }
    ]
  } ]
}
{% endschema %}
