<section class="section">
  <div class="page-width">
    <div class="section-heading center reveal">
      <span class="eyebrow">Shop</span>
      <h1>All Collections</h1>
    </div>
    <div class="grid collection-list">
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" class="collection-tile reveal">
          {%- if collection.featured_image -%}
            <img src="{{ collection.featured_image | image_url: width: 800 }}" alt="{{ collection.title | escape }}" width="800" height="1000" loading="lazy">
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: '' }}
          {%- endif -%}
          <span class="collection-tile__label">{{ collection.title }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "List collections", "settings": [] }
{% endschema %}
